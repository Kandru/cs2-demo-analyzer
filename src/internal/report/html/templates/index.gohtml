{{define "index" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>{{.Title}} · CS2 Demo Analyzer</title>
<style>{{.CSS}}</style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{.IndexFile}}" aria-label="CS2 Demo Analyzer report index">
      <span class="brand-mark">CS2</span>
      <span class="brand-word">DEMO ANALYZER</span>
    </a>
    <nav class="mainnav" aria-label="Sections">
      <a href="{{.IndexFile}}" class="active">Reports</a>
    </nav>
    <div class="topmeta">
      <span>{{.Count}} report(s)</span>
    </div>
  </div>
</header>

<main id="main" class="wrap">
  <section class="section" aria-labelledby="reports-title">
    <div class="section-head">
      <h1 id="reports-title">Match reports</h1>
      <span class="section-note">Newest first · grouped by server</span>
    </div>

    {{if .Groups}}
    <div class="index-groups">
      {{range $i, $group := .Groups}}
      <section class="index-group" aria-labelledby="index-server-{{$i}}">
        <div class="index-group-head">
          <h3 id="index-server-{{$i}}">{{$group.Name}}</h3>
          <span>{{len $group.Entries}} report(s)</span>
        </div>
        <div class="index-grid">
          {{range $group.Entries}}
          <article class="index-card">
            <a class="index-report" href="{{.Href}}">
              <span class="index-line">
                <span class="index-name">{{.Name}}</span>
                {{with .Score}}<span class="index-score">{{.}}</span>{{end}}
              </span>
              <span class="index-meta">
                {{if .ServerName}}<span class="index-server">{{.ServerName}}</span>{{end}}
                {{if .Played}}<span class="index-date">{{if .ServerName}} · {{end}}{{.Played}}</span>{{end}}
              </span>
            </a>
            {{with .Demo}}
            <a class="index-demo" href="{{.Href}}" download="{{.Name}}" title="Download {{.Name}}">Download demo{{if .Size}} · {{.Size}}{{end}}</a>
            {{else}}
            <span class="index-demo muted">Demo not linked</span>
            {{end}}
          </article>
          {{end}}
        </div>
      </section>
      {{end}}
    </div>
    {{else}}
    <p class="muted">No match reports in this directory yet.</p>
    {{end}}
  </section>
</main>

<footer class="footer wrap">
  <span><a href="{{.RepoURL}}" rel="noopener noreferrer">CS2 Demo Analyzer</a> v{{.Version}} — generated {{.GeneratedAt}}</span>
</footer>
</body>
</html>
{{- end}}
