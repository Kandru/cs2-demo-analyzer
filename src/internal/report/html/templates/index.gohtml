{{define "index" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="description" content="{{.Description}}">
<meta name="author" content="{{author}}">
<meta name="generator" content="cs2-demo-analyzer v{{.Version}}">
<title>{{.Title}} - CS2 Demo Analyzer</title>
<link rel="icon" type="image/png" href="{{.Assets.Favicon}}">
<link rel="apple-touch-icon" sizes="152x152" href="{{.Assets.AppleTouch}}">
<style>{{.CSS}}</style>
</head>
<body class="index-page">
<a class="skip-link" href="#main">Skip to content</a>

{{template "topbar" .}}

<main id="main" class="wrap">
  <section class="index-hero cs-panel" aria-labelledby="reports-title">
    <img class="index-logo" src="{{.Assets.Logo}}" alt="" width="560" height="313">
    <div class="index-hero-text">
      <span class="eyebrow">Reports</span>
      <h1 id="reports-title">Match reports</h1>
      <p class="hero-sub">Newest first - grouped by server - {{byline}}</p>
      <div class="index-stats">
        <span><b>{{.Count}}</b> report(s)</span>
        <span><b>{{.Servers}}</b> server(s)</span>
        {{if .Newest}}<span><b>Newest</b> {{.Newest}}</span>{{end}}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reports-title-list">
    <div class="section-head">
      <h2 id="reports-title-list">All reports</h2>
      <span class="section-note">Select a card to open the full match report</span>
    </div>

    {{if .Groups}}
    <div class="index-groups">
      {{range $i, $group := .Groups}}
      <section class="index-group" aria-labelledby="index-server-{{$i}}">
        <div class="index-group-head">
          <h3 id="index-server-{{$i}}">{{$group.Name}}</h3>
          <span>{{len $group.Entries}} report(s)</span>
        </div>
        <div class="index-grid">
          {{range $group.Entries}}
          <article class="index-card cs-panel">
            <a class="index-report" href="{{.Href}}">
              <span class="index-line">
                <span class="index-name">{{.Name}}</span>
                {{with .Score}}<span class="index-score">{{.}}</span>{{end}}
              </span>
              <span class="index-meta">
                {{if .ServerName}}<span class="index-server">{{.ServerName}}</span>{{end}}
                {{if .Played}}<span class="index-date">{{if .ServerName}} - {{end}}{{.Played}}</span>{{end}}
              </span>
              <span class="index-open">Open report</span>
            </a>
            {{with .Demo}}
            <a class="index-demo" href="{{.Href}}" download="{{.Name}}" title="Download {{.Name}}">Download demo{{if .Size}} - {{.Size}}{{end}}</a>
            {{else}}
            <span class="index-demo muted">Demo not linked</span>
            {{end}}
          </article>
          {{end}}
        </div>
      </section>
      {{end}}
    </div>
    {{else}}
    <div class="cs-panel empty-state">
      <h3>No match reports yet</h3>
      <p class="muted">Analyze a demo to create the first report in this directory.</p>
    </div>
    {{end}}
  </section>
</main>

{{template "footer" .}}
{{template "sprite" .}}
</body>
</html>
{{- end}}
