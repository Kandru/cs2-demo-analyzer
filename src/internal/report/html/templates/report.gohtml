{{define "report" -}}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="description" content="{{.Description}}">
<meta name="author" content="{{author}}">
<meta name="generator" content="cs2-demo-analyzer v{{.Version}}">
<title>{{.Title}} - CS2 Demo Analyzer</title>
<link rel="icon" type="image/png" href="{{.Assets.Favicon}}">
<link rel="apple-touch-icon" sizes="152x152" href="{{.Assets.AppleTouch}}">
<style>{{.CSS}}</style>
</head>
<body class="report-page">
<a class="skip-link" href="#main">Skip to content</a>

{{template "topbar" .}}

<main id="main" class="wrap">
  <section class="hero cs-panel" aria-labelledby="match-title">
    <div class="hero-main">
      <div class="hero-id">
        <span class="eyebrow">Match report</span>
        <h1 id="match-title">{{.Match.Map}}</h1>
        <p class="hero-sub">{{.Match.Mode}} - {{clock .Match.Duration}} - {{if .Summary}}{{.Summary.Rounds}}{{else}}{{len .Match.Rounds}}{{end}} rounds</p>
      </div>

      <div class="hero-score" role="group" aria-label="Match score">
        {{range $i, $team := .Teams}}
        {{if eq $i 1}}
        <div class="hero-score-num">
          {{if $.Summary}}<span class="{{(index $.Teams 0).ScoreClass}}">{{index $.Summary.Score 0}}</span><em>:</em><span class="{{.ScoreClass}}">{{index $.Summary.Score 1}}</span>{{end}}
        </div>
        {{end}}
        <a class="hero-team {{lower .Side}} {{if .Win}}winner{{end}}" href="#scoreboard">
          <span class="hero-team-name">{{.DisplayName}}</span>
          <span class="hero-team-side"><i class="side-dot {{lower .Side}}" aria-hidden="true"></i>{{.Side}} start{{if .Win}} - winner{{end}}</span>
        </a>
        {{end}}
      </div>

      <div class="hero-verdict">
        {{if .Summary}}{{if .Summary.WinnerName}}<span class="hero-winner">{{.Summary.WinnerName}}</span><span class="hero-winner-label">wins the match</span>{{end}}{{end}}
        {{if .Match.Warnings}}<span class="badge badge--warning" title="{{range .Match.Warnings}}{{.}}&#10;{{end}}">{{len .Match.Warnings}} warning(s)</span>{{end}}
      </div>
    </div>

    <div class="hero-meta">
      {{with .DemoDownload}}<a class="demo-download" href="{{.Href}}" download="{{.Name}}" title="Download {{.Name}}">Download demo{{if .Size}} - {{.Size}}{{end}}</a>{{else}}<span><b>Demo</b> {{.Match.DemoName}}</span>{{end}}
      {{if .Match.ServerName}}<span><b>Server</b> {{.Match.ServerName}}</span>{{end}}
      <span><b>Played</b> {{.Match.FileTime.Format "Mon, 02 Jan 2006 15:04"}}</span>
      <span><b>Players</b> {{len .Match.Players}}</span>
      <span><b>Tickrate</b> {{zero .Match.TickRate}}</span>
      <span><b>Report</b> v{{.Version}}</span>
    </div>
  </section>

  <section id="overview" class="section">
    <div class="section-head">
      <h2>Overview</h2>
      <span class="section-note">The match at a glance</span>
    </div>

    <div class="badge-row match-badges">
      <span class="badge badge--accent">{{.Match.Map}}</span>
      <span class="badge">{{.Match.Mode}}</span>
      <span class="badge">{{clock .Match.Duration}}</span>
      <span class="badge">{{if .Summary}}{{.Summary.Rounds}}{{else}}{{len .Match.Rounds}}{{end}} rounds</span>
      <span class="badge">{{len .Match.Players}} players</span>
      <span class="badge">{{zero .Match.TickRate}} tick</span>
      <span class="badge">{{.Match.FileTime.Format "02 Jan 2006"}}</span>
      {{if .Match.ServerName}}<span class="badge badge--info">{{.Match.ServerName}}</span>{{end}}
      {{if .Match.Warnings}}<span class="badge badge--warning">{{len .Match.Warnings}} warning(s)</span>{{end}}
    </div>

    {{with .Summary}}
    <div class="stat-grid">
      <div class="stat-tile">
        <span class="stat-label">Winner</span>
        <span class="stat-value">{{if .WinnerName}}{{.WinnerName}}{{else}}Draw{{end}}</span>
        <span class="stat-sub">{{index .Score 0}} : {{index .Score 1}}</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">Top fragger</span>
        <span class="stat-value">{{if .TopFraggerName}}{{.TopFraggerName}}{{else}}-{{end}}</span>
        <span class="stat-sub">{{.TopFraggerKills}} kills</span>
      </div>
      <div class="stat-tile">
        <span class="stat-label">Best aim</span>
        <span class="stat-value">{{if .BestAimName}}{{.BestAimName}}{{else}}-{{end}}</span>
        <span class="stat-sub">{{if .BestAimName}}{{zero .BestAimRating}} - {{.BestAimGrade}}{{else}}no sample{{end}}</span>
      </div>
      <a class="stat-tile stat-link {{if gt .FlaggedPlayers 0}}is-alert{{end}}" href="#cheaters">
        <span class="stat-label">Watchlist</span>
        <span class="stat-value">{{.FlaggedPlayers}}{{if $.Cheaters}} <em>/ {{len $.Cheaters}}</em>{{end}}</span>
        <span class="stat-sub">{{if gt .FlaggedPlayers 0}}flagged players{{else if $.Cheaters}}review players{{else}}no player above 25%{{end}}</span>
      </a>
      <div class="stat-tile">
        <span class="stat-label">Rounds</span>
        <span class="stat-value">{{.Rounds}}</span>
        <span class="stat-sub">regulation {{.RegulationRounds}}</span>
      </div>
    </div>
    {{end}}

    <div class="cs-panel round-history">
      <div class="panel-head">
        <h3 class="panel-title">Round history</h3>
        <div class="legend">
          <span><i class="legend-swatch ct"></i>CT win</span>
          <span><i class="legend-swatch t"></i>T win</span>
          <span><i class="legend-dot"></i>flagged</span>
        </div>
      </div>
      <div class="round-strip" role="list">
        {{range .RoundStrip}}
        <a class="round-cell {{.Class}} {{if .HasFlag}}has-flag{{end}}" href="#{{.Anchor}}" title="{{.Title}}" role="listitem">
          <span class="round-cell-num">{{.Label}}{{if .Overtime}}<em>OT</em>{{end}}</span>
          <span class="round-cell-score">{{.Score}}</span>
          <span class="round-cell-buy {{.BuyClass}}" aria-hidden="true"></span>
          {{if .HasFlag}}<span class="round-cell-flag" aria-label="flagged activity">&#9873;</span>{{end}}
        </a>
        {{end}}
      </div>
    </div>

    <div id="scoreboard" class="overview-scoreboard">
      <div class="panel-head">
        <h3 class="panel-title">Scoreboard</h3>
        <span class="section-note">Match totals - select a player for details</span>
      </div>
      <div class="teams">
        {{range .Teams}}
        <div class="cs-panel team-board {{lower .Side}} {{if .Win}}is-winner{{end}}">
          <div class="team-head">
            <div>
              <span class="team-side"><i class="side-dot {{lower .Side}}" aria-hidden="true"></i> {{.Side}}</span>
              <h3>{{.DisplayName}}</h3>
            </div>
            <div class="team-score {{.ScoreClass}}">{{.Team.Score}}{{if .Win}}<span class="win-mark">WIN</span>{{end}}</div>
          </div>
          <div class="team-aggregate">
            <span class="badge">{{.Stats.Kills}} K</span>
            <span class="badge">{{.Stats.Deaths}} D</span>
            <span class="badge">{{.Stats.Assists}} A</span>
            <span class="badge badge--accent">{{one .Stats.ADR}} ADR</span>
            <span class="badge">{{zero .Stats.HSPercent}}% HS</span>
            <span class="badge badge--accent">{{zero .Stats.AimRating}} AIM</span>
          </div>
          <div class="table-scroll">
          <table class="score-table">
            <caption class="sr-only">{{.DisplayName}} scoreboard</caption>
            <thead>
              <tr><th scope="col" class="name">Player</th><th scope="col">Score</th><th scope="col">K</th><th scope="col">D</th><th scope="col">A</th><th scope="col">K/D</th><th scope="col">ADR</th><th scope="col">HS</th><th scope="col">AIM</th><th scope="col">MVP</th></tr>
            </thead>
            <tbody>
            {{range .Players}}
              <tr class="{{if .Flagged}}flagged{{end}}">
                <th scope="row" class="name"><a href="#{{.Anchor}}">{{.Player.Name}}</a>{{if .Player.ClanTag}} <span class="clan">[{{.Player.ClanTag}}]</span>{{end}}{{if .Flagged}} <span class="flag-dot" role="img" aria-label="flagged by anti-cheat" title="Flagged by anti-cheat">&#9873;</span>{{end}}{{if .Player.IsBot}} <span class="badge badge--neutral">BOT</span>{{end}}</th>
                <td>{{.ScoreDisplay}}</td>
                <td>{{.Player.Stats.Kills}}</td>
                <td>{{.Player.Stats.Deaths}}</td>
                <td>{{.Player.Stats.Assists}}</td>
                <td>{{.KDDisplay}}</td>
                <td>{{.ADRDisplay}}</td>
                <td>{{.HSDisplay}}</td>
                <td class="aim-cell">{{if .AimDisplay}}{{.AimDisplay}} <span class="grade {{gradeClass .AimGrade}}">{{.AimGrade}}</span>{{else}}-{{end}}</td>
                <td>{{.Player.Stats.MVPs}}</td>
              </tr>
            {{end}}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row" class="name">Team total</th>
                <td>-</td>
                <td>{{.Stats.Kills}}</td>
                <td>{{.Stats.Deaths}}</td>
                <td>{{.Stats.Assists}}</td>
                <td>-</td>
                <td>{{one .Stats.ADR}}</td>
                <td>{{zero .Stats.HSPercent}}%</td>
                <td>{{zero .Stats.AimRating}}</td>
                <td>-</td>
              </tr>
            </tfoot>
          </table>
          </div>
        </div>
        {{end}}
      </div>
    </div>

    {{if .Warnings}}
    <div class="cs-panel warnings">
      <h3 class="panel-title">Parser warnings</h3>
      <ul>{{range .Warnings}}<li>{{.}}</li>{{end}}</ul>
    </div>
    {{end}}
  </section>

  <section id="cheaters" class="section">
    <div class="section-head">
      <h2>Watchlist</h2>
      <span class="section-note">Flagged and review-level players - timestamps point at the demo</span>
    </div>

    {{if .Cheaters}}
    <div class="cheater-list">
      {{range .Cheaters}}
      <article class="cheater-card cs-panel {{.Cheat.VerdictClass}}" id="cheater-{{.Player.Player.Slug}}" data-search="{{.Search}}">
        <header class="cheater-head">
          <div class="cheater-id">
            <span class="avatar {{lower .Player.Side}}">{{.Player.Initials}}</span>
            <div>
              <h3><a href="#{{.Player.Anchor}}">{{.Player.Player.Name}}</a>{{if .Player.Player.ClanTag}} <span class="clan">[{{.Player.Player.ClanTag}}]</span>{{end}}</h3>
              <div class="cheater-sub">
                {{if .Player.TeamName}}<span class="badge badge--{{if eq .Player.Side "CT"}}ct{{else if eq .Player.Side "T"}}t{{else}}neutral{{end}}">{{.Player.TeamName}}</span>{{end}}
                <span>{{.Player.Player.RoundsPlayed}} rounds</span>
                <span>{{.Player.Player.Stats.Kills}} / {{.Player.Player.Stats.Deaths}} / {{.Player.Player.Stats.Assists}}</span>
                {{if .Player.Player.IsBot}}<span class="badge badge--neutral">BOT</span>{{end}}
              </div>
            </div>
          </div>
          <div class="cheater-verdict">
            <span class="verdict {{.Cheat.VerdictClass}}">{{.Cheat.Verdict}}</span>
            <span class="cheater-likelihood">{{.Cheat.LikelihoodPct}}</span>
            <span class="muted small">likelihood - flag at 50%</span>
          </div>
        </header>
        <div class="meter"><i class="{{.Cheat.VerdictClass}}" style="width:{{.Cheat.Likelihood}}%"></i></div>

        <div class="cheater-body">
          <div>
            <h4>Signals</h4>
            {{template "channel-list" .TopChannels}}
            {{if .Cheat.Grades}}
            <div class="badge-row grades">
              {{range .Cheat.Grades}}<span class="grade-chip"><span>{{.Label}}</span><b class="grade {{gradeClass .Grade}}">{{.Grade}}</b></span>{{end}}
              {{if .Cheat.OverallGrade}}<span class="grade-chip overall"><span>Overall</span><b class="grade {{gradeClass .Cheat.OverallGrade}}">{{.Cheat.OverallGrade}}</b></span>{{end}}
            </div>
            {{end}}
            {{if .Cheat.Adjustments}}{{template "adjustments" .Cheat.Adjustments}}{{end}}
          </div>
          <div>
            <h4>When to look</h4>
            {{if .TopMoments}}
            {{template "cue-list" .TopMoments}}
            {{else}}
            <p class="muted">No timestamped cue passed the recording thresholds.</p>
            {{end}}
            <p class="disclaimer small">Cues mark detector thresholds, not confirmed cheating. Statistical signal, not proof.</p>
          </div>
        </div>
        <footer class="cheater-foot">
          <a href="#{{.Player.Anchor}}">Open full analysis</a>
        </footer>
      </article>
      {{end}}
    </div>
    {{else}}
    <div class="cs-panel empty-state">
      <h3>No players on the watchlist</h3>
      <p class="muted">Nobody crossed the 25% review level or the 50% flag threshold.</p>
      <p><a href="#players">Open player details</a></p>
    </div>
    {{end}}
  </section>

  <section id="rounds" class="section">
    <div class="section-head">
      <h2>Timeline</h2>
      <span class="section-note">One continuous demo time scale - absolute timestamps</span>
    </div>

    <div class="timeline-toolbar cs-panel">
      <div class="segmented" role="group" aria-label="Event filter">
        <button type="button" data-evt-filter="all" class="active">All</button>
        <button type="button" data-evt-filter="kill">Kills</button>
        <button type="button" data-evt-filter="bomb">Bombs</button>
        <button type="button" data-evt-filter="grenade">Utility</button>
        <button type="button" data-evt-filter="mvp">MVP</button>
        <button type="button" data-evt-filter="lifecycle">Players</button>
        <button type="button" data-evt-filter="round">Round</button>
      </div>
      <select id="player-filter" aria-label="Filter timeline by player">
        <option value="">All players</option>
        {{range .Players}}<option value="{{.Player.ID}}">{{.Player.Name}}</option>{{end}}
      </select>
    </div>

    <div class="timeline">
      {{range .Timeline}}{{template "timeline-section" .}}{{end}}
    </div>
  </section>

  <section id="players" class="section">
    <div class="section-head">
      <h2>Players</h2>
      <span class="section-note">Stats, aim profile and cheat analysis</span>
    </div>

    <nav class="player-pills" aria-label="Player shortcuts">
      {{range .Players}}<a href="#{{.Anchor}}" class="pill {{if .Flagged}}flagged{{end}}" data-target="{{.Anchor}}">{{.Player.Name}}</a>{{end}}
    </nav>

    <div class="player-grid">
    {{range .Players}}
    <article class="player-card cs-panel" id="{{.Anchor}}" data-search="{{.Search}}">
      <header class="player-head">
        <div class="avatar {{lower .Side}}">{{.Initials}}</div>
        <div class="player-id">
          <h3>{{.Player.Name}}{{if .Flagged}} <span class="flag-dot" role="img" aria-label="flagged by anti-cheat">&#9873;</span>{{end}}</h3>
          <div class="player-sub">
            {{if .TeamName}}<span class="badge badge--{{if eq .Side "CT"}}ct{{else if eq .Side "T"}}t{{else}}neutral{{end}}">{{.TeamName}}</span>{{end}}
            {{if .Player.SteamID64}}<a class="badge badge--info" href="https://steamcommunity.com/profiles/{{.Player.SteamID64}}" target="_blank" rel="noopener noreferrer">Steam profile</a>{{end}}
            <span>{{.Player.RoundsPlayed}} rounds</span>
            {{if .Player.IsBot}}<span class="badge badge--neutral">BOT</span>{{end}}
          </div>
        </div>
        <div class="player-verdicts">
          {{if .AimDisplay}}<span class="aim-badge">AIM {{.AimDisplay}} <b>{{.AimGrade}}</b></span>{{end}}
          {{with .Cheat}}<span class="verdict {{.VerdictClass}}">{{.Verdict}}</span>{{end}}
        </div>
      </header>

      <div class="player-body">
        <div class="player-main">
          <div class="stat-strip">
            <div><span>Kills</span><b>{{.Player.Stats.Kills}}</b></div>
            <div><span>Deaths</span><b>{{.Player.Stats.Deaths}}</b></div>
            <div><span>Assists</span><b>{{.Player.Stats.Assists}}</b></div>
            <div><span>K/D</span><b>{{.KDDisplay}}</b></div>
            <div><span>ADR</span><b>{{.ADRDisplay}}</b></div>
            <div><span>HS</span><b>{{.HSDisplay}}</b></div>
            <div><span>KAST</span><b>{{zero .Player.Stats.KASTPercent}}%</b></div>
            <div><span>MVPs</span><b>{{.Player.Stats.MVPs}}</b></div>
            <div><span>First kills</span><b>{{.Player.Stats.FirstKills}}</b></div>
            <div><span>Plants / defuses</span><b>{{.Player.Stats.Plants}} / {{.Player.Stats.Defuses}}</b></div>
            <div><span>Clutches</span><b>{{.Player.Stats.Clutches}}</b></div>
            <div><span>Utility dmg</span><b>{{.Player.Stats.UtilityDamage}}</b></div>
          </div>

          {{if .Sides}}
          <div class="side-split">
            {{range .Sides}}
            <div class="side-row {{lower .Side}}">
              <b>{{.Side}}</b><span>{{.Rounds}} rounds</span><span>{{.Kills}} / {{.Deaths}} / {{.Assists}}</span><span>{{.ADR}} ADR</span><span>{{.HS}} HS</span>
            </div>
            {{end}}
          </div>
          {{end}}

          {{if .Aim}}
          <section class="subpanel aim-panel">
            <div class="panel-head">
              <h4>Aim</h4>
              <div class="aim-rating"><b>{{.AimDisplay}}</b><span>{{.AimGrade}}</span></div>
            </div>
            <div class="aim-grid">
              {{range .Aim}}
              <div class="aim-tile {{.Class}}" title="{{.Tooltip}} ({{.SampleLabel}})">
                <span class="aim-label">{{.Label}}</span>
                <span class="aim-value">{{.Display}}</span>
                <span class="bar aim-bar"><i style="width:{{.ScorePct}}%"></i></span>
                <span class="aim-sample">{{if .LowSample}}low sample - {{end}}{{.SampleLabel}}</span>
              </div>
              {{end}}
            </div>
            <p class="disclaimer small">Aim metrics use fixed anchors, not rank data. Hover a tile for its definition and sample count.</p>
          </section>
          {{end}}

          <section class="subpanel">
            <h4>Weapons</h4>
            {{if .Weapons}}
            <div class="table-scroll">
            <table class="mini-table">
              <caption class="sr-only">Weapon statistics</caption>
              <thead><tr><th scope="col">Weapon</th><th scope="col">K</th><th scope="col">HS</th><th scope="col">DMG</th><th scope="col">Shots</th><th scope="col">Hits</th><th scope="col">Acc.</th></tr></thead>
              <tbody>{{range .Weapons}}<tr><th scope="row">{{.Name}}</th><td>{{.Kills}}</td><td>{{.HSRate}}</td><td>{{if .Damage}}{{.Damage}}{{else}}-{{end}}</td><td>{{if .Shots}}{{.Shots}}{{else}}-{{end}}</td><td>{{if .Hits}}{{.Hits}}{{else}}-{{end}}</td><td>{{.Accuracy}}</td></tr>{{end}}</tbody>
            </table>
            </div>
            {{else}}<p class="muted">No weapon data.</p>{{end}}
          </section>
        </div>

        <aside class="player-side">
          {{with .Cheat}}
          <section class="subpanel cheat-panel {{.VerdictClass}}">
            <div class="panel-head">
              <h4>Cheat analysis</h4>
              <span class="verdict {{.VerdictClass}}">{{.Verdict}}</span>
            </div>
            {{if .Available}}
            <div class="cheat-meter-row">
              <span class="meter"><i class="{{.VerdictClass}}" style="width:{{.Likelihood}}%"></i></span>
              <b class="cheat-likelihood">{{.LikelihoodPct}}</b>
              <span class="muted">likelihood - flag at 50%</span>
            </div>
            {{if .Grades}}
            <div class="badge-row grades">
              {{range .Grades}}<span class="grade-chip"><span>{{.Label}}</span><b class="grade {{gradeClass .Grade}}">{{.Grade}}</b></span>{{end}}
              {{if .OverallGrade}}<span class="grade-chip overall"><span>Overall</span><b class="grade {{gradeClass .OverallGrade}}">{{.OverallGrade}}</b></span>{{end}}
            </div>
            {{end}}
            {{template "channel-list" .Channels}}
            {{if .Adjustments}}{{template "adjustments" .Adjustments}}{{end}}
            <p class="disclaimer small">Detector: vendored demo-anticheat (10-channel Bayesian model). Statistical signal, not proof. Small samples reduce confidence.</p>
            {{else}}
            <p class="error-text">Cheat analysis unavailable: {{.Error}}</p>
            {{end}}
          </section>
          {{end}}

          {{if and .ShowReview .Moments}}
          <section class="subpanel review-panel">
            <div class="panel-head">
              <h4>When to look</h4>
              <span class="muted small">{{.MomentCount}} cue(s)</span>
            </div>
            <p class="muted small">Copy a tick and run <code>demo_gototick &lt;tick&gt;</code> in the demo console.</p>
            {{template "cue-list" .TopMoments}}
            {{if gt .MomentCount (len .TopMoments)}}
            <details class="details-compact">
              <summary>All {{.MomentCount}} cues</summary>
              {{template "cue-list" .Moments}}
            </details>
            {{end}}
            <p class="disclaimer small">Review cues only. They mark detector thresholds, not confirmed cheating.</p>
          </section>
          {{end}}
        </aside>

        <section class="subpanel player-rounds">
          <h4>Per round</h4>
          {{if .Rounds}}
          <div class="table-scroll">
          <table class="mini-table round-table">
            <caption class="sr-only">Per-round statistics</caption>
            <thead><tr><th scope="col">Round</th><th scope="col">Side</th><th scope="col">K</th><th scope="col">D</th><th scope="col">A</th><th scope="col">DMG</th><th scope="col">Equip</th><th scope="col">Result</th></tr></thead>
            <tbody>
            {{range .Rounds}}<tr><td><a href="#{{.Anchor}}">{{.Number}}</a></td><td><i class="side-dot {{lower .Side}}" aria-hidden="true"></i> {{.Side}}</td><td>{{.Kills}}</td><td>{{.Deaths}}</td><td>{{.Assists}}</td><td>{{.Damage}}</td><td>{{.EquipValue}}</td><td class="{{.ResultClass}}">{{.Result}}{{if .KAST}} - KAST{{end}}</td></tr>{{end}}
            </tbody>
          </table>
          </div>
          {{else}}<p class="muted">No round data.</p>{{end}}
        </section>
      </div>
    </article>
    {{end}}
    </div>
  </section>
</main>

{{template "search-index" .}}
{{template "footer" .}}
{{template "sprite" .}}
<script>{{.JS}}</script>
</body>
</html>
{{- end}}
